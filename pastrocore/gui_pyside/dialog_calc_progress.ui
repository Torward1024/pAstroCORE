       <property name="styleSheet">
        <string notr="true">/* Стилизация QProgressBar */
QProgressBar {
    font-family: Arial;
    font-size: 9pt;
    color: #333333;
    background-color: #f9f9f9; /* Фон неактивных элементов */
    border: 1px solid #d3d3d3; /* Граница неактивного состояния */
    border-radius: 3px; /* Скругленные углы */
    text-align: center; /* Выравнивание текста по центру */
}
/* Стилизация заполненной части прогресс-бара */
QProgressBar::chunk {
    background-color: #0078d7; /* Основной акцентный цвет */
    border-radius: 2px; /* Скругление внутри, чтобы учитывать границу */
}</string>
