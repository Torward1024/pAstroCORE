         <item row="12" column="1">
          <widget class="QComboBox" name="mountTypeCombo">
           <property name="font">
            <font>
             <family>Arial</family>
             <pointsize>9</pointsize>
            </font>
           </property>
           <property name="styleSheet">
            <string notr="true">QComboBox {
    font-family: Arial;
    font-size: 9pt;
    color: #333333;
    padding: 1px;
    border-radius: 3px;
    background-color: #f9f9f9; /* Базовый фон, как у readOnly QLineEdit */
    border: 1px solid #d3d3d3; /* Базовая граница, как у readOnly QLineEdit */
}

QComboBox:editable {
    background-color: #f0f6ff; /* Фон для редактируемого состояния, как у readOnly=&quot;false&quot; */
    border: 1px solid #0078d7; /* Граница для редактируемого состояния */
}

QComboBox:editable:hover {
    border: 1px solid #1a8cff; /* Граница при наведении, как у readOnly=&quot;false&quot;:hover */
}

QComboBox:editable:focus {
    border: 1px solid #005bb5; /* Граница при фокусе, как у readOnly=&quot;false&quot;:focus */
    background-color: #ffffff; /* Фон при фокусе, как у readOnly=&quot;false&quot;:focus */
}

QComboBox:!editable {
    background-color: #f0f6ff; /* Фон для редактируемого состояния, как у readOnly=&quot;false&quot; */
    border: 1px solid #0078d7; /* Граница для редактируемого состояния */
}

QComboBox:!editable:hover {
    border: 1px solid #1a8cff; /* Граница при наведении, как у readOnly=&quot;false&quot;:hover */
}

QComboBox:!editable:focus {
    border: 1px solid #005bb5; /* Граница при фокусе, как у readOnly=&quot;false&quot;:focus */
    background-color: #ffffff; /* Фон при фокусе, как у readOnly=&quot;false&quot;:focus */
}

/* Стилизация кнопки со стрелкой */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    border-left: 1px solid #d3d3d3; /* Добавлена граница для визуального разделения */
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: #f9f9f9; /* Фон кнопки, совпадающий с основным */
}

QComboBox::drop-down:hover {
    background-color: #0078d7; /* Лёгкое выделение при наведении */
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/down_arrow_icon.svg);
}

/* Стилизация выпадающего списка */
QComboBox QAbstractItemView {
    font-family: Arial;
    font-size: 12pt;
    color: #333333;
    background-color: #ffffff;
    border: 1px solid #d3d3d3;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
    padding: 1px;
}

QComboBox QAbstractItemView::item {
    padding: 4px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #0078d7;
}</string>
           </property>
           <item>
            <property name="text">
             <string>EQUA</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>AZIM</string>
            </property>
           </item>
          </widget>
         </item>
         <item row="13" column="0">
          <widget class="QLabel" name="labelIsActive">
           <property name="text">
            <string>Active:</string>
           </property>
          </widget>
         </item>
         <item row="13" column="1">
          <widget class="QCheckBox" name="isActiveCheckBox">
           <property name="styleSheet">
            <string notr="true">/* Основной стиль QCheckBox */
QCheckBox {
    font-family: Arial;
    font-size: 9pt;
    color: #333333;
    spacing: 6px;
    padding: 2px;
    outline: none;
}

QCheckBox::item {
    padding: 2px;
}

/* Индикатор чекбокса */
QCheckBox::indicator {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    border: 1px solid #d3d3d3;
    background-color: #f9f9f9;
}

/* Unchecked состояние */
QCheckBox::indicator:unchecked {
    border: 1px solid #d3d3d3;
    background-color: #f9f9f9;
    image: none;
}

QCheckBox::indicator:unchecked:hover {
    border: 1px solid #1a8cff;
    background-color: #f0f6ff;
    image: none;
}

QCheckBox::indicator:unchecked:focus {
    border: 1px solid #005bb5;
    background-color: #f0f6ff;
    image: none;
}

/* Checked состояние - БЕЛЫЙ ФОН, стандартная граница */
QCheckBox::indicator:checked {
    border: 1px solid #0078d7;
    background-color: #ffffff; /* Белый фон */
    image: url(:/icons/check_icon.svg);
}

QCheckBox::indicator:checked:hover {
    border: 1px solid #1a8cff; /* Стандартная толщина */
    background-color: #ffffff; /* Белый фон */
    image: url(:/icons/check_icon_hover.svg);
}

QCheckBox::indicator:checked:focus {
    border: 1px solid #005bb5; /* Стандартная толщина */
    background-color: #ffffff; /* Белый фон */
    image: url(:/icons/check_icon.svg);
}

/* Disabled состояния */
QCheckBox::indicator:unchecked:disabled {
    border: 1px solid #e0e0e0;
    background-color: #f5f5f5;
    image: none;
}

QCheckBox::indicator:checked:disabled {
    border: 1px solid #cccccc;
    background-color: #f0f0f0; /* Светло-серый фон */
    image: url(:/icons/check_icon_disabled.svg);
}

QCheckBox:disabled {
    color: #999999;
}</string>
           </property>
           <property name="checked">
            <bool>true</bool>
           </property>
          </widget>
         </item>
