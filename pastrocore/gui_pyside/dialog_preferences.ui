           </property>
          </widget>
         </item>
         <item row="0" column="2">
          <widget class="QPushButton" name="openSourcesCatalogButton">
           <property name="styleSheet">
            <string notr="true">QPushButton {
    background-color: #0078d7;
    color: #ffffff;
    padding: 6px;
    border-radius: 3px;
    border: none;
}
QPushButton:hover {
    background-color: #1a8cff; /* Светлее при наведении */
}
QPushButton:pressed {
    background-color: #005bb5; /* Темнее при нажатии */
    padding-top: 7px; /* Легкое смещение вниз для эффекта &quot;продавливания&quot; */
    padding-bottom: 5px;
}</string>
           </property>
           <property name="text">
            <string>Open...</string>
           </property>
           <property name="autoDefault">
            <bool>false</bool>
           </property>
           <property name="flat">
            <bool>true</bool>
           </property>
          </widget>
