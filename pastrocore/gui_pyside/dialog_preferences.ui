           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QComboBox" name="comboLogging">
           <property name="styleSheet">
            <string notr="true">QComboBox {
    font-family: Arial;
    font-size: 9pt;
    color: #333333;
    padding: 1px;
    border-radius: 3px;
    background-color: #f9f9f9; /* Базовый фон, как у readOnly QLineEdit */
    border: 1px solid #d3d3d3; /* Базовая граница, как у readOnly QLineEdit */
}

QComboBox:editable {
    background-color: #f0f6ff; /* Фон для редактируемого состояния, как у readOnly=&quot;false&quot; */
    border: 1px solid #0078d7; /* Граница для редактируемого состояния */
}

QComboBox:editable:hover {
    border: 1px solid #1a8cff; /* Граница при наведении, как у readOnly=&quot;false&quot;:hover */
}

QComboBox:editable:focus {
    border: 1px solid #005bb5; /* Граница при фокусе, как у readOnly=&quot;false&quot;:focus */
    background-color: #ffffff; /* Фон при фокусе, как у readOnly=&quot;false&quot;:focus */
}

QComboBox:!editable {
    background-color: #f0f6ff; /* Фон для редактируемого состояния, как у readOnly=&quot;false&quot; */
    border: 1px solid #0078d7; /* Граница для редактируемого состояния */
}

QComboBox:!editable:hover {
    border: 1px solid #1a8cff; /* Граница при наведении, как у readOnly=&quot;false&quot;:hover */
}

QComboBox:!editable:focus {
    border: 1px solid #005bb5; /* Граница при фокусе, как у readOnly=&quot;false&quot;:focus */
    background-color: #ffffff; /* Фон при фокусе, как у readOnly=&quot;false&quot;:focus */
}

/* Стилизация кнопки со стрелкой */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    border-left: 1px solid #d3d3d3; /* Добавлена граница для визуального разделения */
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: #f9f9f9; /* Фон кнопки, совпадающий с основным */
}

QComboBox::drop-down:hover {
    background-color: #0078d7; /* Лёгкое выделение при наведении */
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    /* Стандартная стрелка Qt, если нет иконки */
    /* Если есть иконка, раскомментируйте: */
    /* image: url(:/icons/down_arrow.png); */
}

/* Стилизация выпадающего списка */
QComboBox QAbstractItemView {
    font-family: Arial;
    font-size: 12pt;
    color: #333333;
    background-color: #ffffff;
    border: 1px solid #d3d3d3;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
    padding: 1px;
}

QComboBox QAbstractItemView::item {
    padding: 4px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #0078d7;
}</string>
           </property>
