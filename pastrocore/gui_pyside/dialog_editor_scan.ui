     <item row="1" column="0" colspan="2">
      <widget class="QTableView" name="tab_telescopes">
       <property name="styleSheet">
        <string notr="true">/* QTableView and QHeaderView styles for pAstroCORE */

/* Table View */
QTableView, QTableWidget {
    background-color: #ffffff;
    gridline-color: #d3d3d3;
    color: #333333;
    font-family: Arial, sans-serif;
    font-size: 9pt;
    border: 1px solid #d3d3d3; /* External border for table */
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: #0078d7;
    color: #ffffff;
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: #1a8cff;
    color: #ffffff;
}

/* Header View */
QHeaderView {
    background-color: #f9f9f9;
    border: none; /* No external border to avoid doubling with QTableView */
    border-bottom: 1px solid #d3d3d3; /* Bottom border to separate from content */
}

QHeaderView::section {
    background-color: #f9f9f9;
    color: #333333;
    border-bottom: none; /* No bottom border, handled by QHeaderView */
    border-right: none; /* Avoid doubling with adjacent sections */
    border-left: none; /* Clean look */
    border-top: none; /* Clean look */
    padding: 4px;
    font-family: Arial, sans-serif;
    font-size: 9pt;
}

QHeaderView::section:horizontal {
    border-right: 1px solid #d3d3d3; /* Separator between columns */
}

QHeaderView::section:vertical {
    border-bottom: 1px solid #d3d3d3; /* Separator between rows */
}

QHeaderView::section:hover {
    background-color: #1a8cff;
    color: #ffffff;
}</string>
       </property>
      </widget>
     </item>
