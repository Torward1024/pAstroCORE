   <item row="10" column="1">
    <widget class="QPushButton" name="pushButton">
     <property name="styleSheet">
      <string notr="true">QPushButton {
    background-color: #0078d7;
    color: #ffffff;
    padding: 6px;
    border-radius: 3px;
    border: none;
}
QPushButton:hover {
    background-color: #1a8cff; /* Светлее при наведении */
}
QPushButton:pressed {
    background-color: #005bb5; /* Темнее при нажатии */
    padding-top: 7px; /* Легкое смещение вниз для эффекта &quot;продавливания&quot; */
    padding-bottom: 5px;
}</string>
     </property>
     <property name="text">
