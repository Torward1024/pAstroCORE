     <item row="0" column="1">
      <widget class="QDoubleSpinBox" name="frequencyEdit">
       <property name="styleSheet">
        <string notr="true">/* Base style for QDoubleSpinBox */
QDoubleSpinBox {
    font-family: Arial;
    font-size: 9pt;
    color: #333333;
    padding: 1px;
    padding-right: 20px;
    border-radius: 3px;
    background-color: #f9f9f9; /* Matches readOnly QLineEdit background */
    border: 1px solid #d3d3d3; /* Matches readOnly QLineEdit border */
}

/* Editable state */
QDoubleSpinBox:editable {
    background-color: #f0f6ff; /* Matches editable QComboBox background */
    border: 1px solid #0078d7; /* Matches editable QComboBox border */
}

/* Editable hover state */
QDoubleSpinBox:editable:hover {
    border: 1px solid #1a8cff; /* Matches editable QComboBox:hover border */
}

/* Editable focus state */
QDoubleSpinBox:editable:focus {
    border: 1px solid #005bb5; /* Matches editable QComboBox:focus border */
    background-color: #ffffff; /* Matches editable QComboBox:focus background */
}

/* Non-editable state */
QDoubleSpinBox:!editable {
    background-color: #f0f6ff; /* Matches non-editable QComboBox background */
    border: 1px solid #0078d7; /* Matches non-editable QComboBox border */
}

/* Non-editable hover state */
QDoubleSpinBox:!editable:hover {
    border: 1px solid #1a8cff; /* Matches non-editable QComboBox:hover border */
}

/* Non-editable focus state */
QDoubleSpinBox:!editable:focus {
    border: 1px solid #005bb5; /* Matches non-editable QComboBox:focus border */
    background-color: #ffffff; /* Matches non-editable QComboBox:focus background */
}

/* Styling for up/down buttons */
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    subcontrol-origin: padding;
    width: 20px;
    border-left: 1px solid #d3d3d3; /* Visual separation like QComboBox drop-down */
    background-color: #f9f9f9; /* Matches QComboBox drop-down background */
}
/* Hover state for up/down buttons */
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #0078d7; /* Matches QComboBox drop-down:hover */
}

/* Up arrow styling */
QDoubleSpinBox::up-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/up_arrow_icon.svg); /* Ensure this icon exists */
}
/* Down arrow styling */
QDoubleSpinBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/down_arrow_icon.svg); /* Matches QComboBox down-arrow */
}</string>
       </property>
       <property name="decimals">
