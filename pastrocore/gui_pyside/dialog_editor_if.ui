     <item row="3" column="1">
      <widget class="QCheckBox" name="isActiveCheckBox">
       <property name="styleSheet">
        <string notr="true">/* Основной стиль QCheckBox */
QCheckBox {
    font-family: Arial;
    font-size: 9pt;
    color: #333333;
    spacing: 6px;
    padding: 2px;
    outline: none;
}

QCheckBox::item {
    padding: 2px;
}

/* Индикатор чекбокса */
QCheckBox::indicator {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    border: 1px solid #d3d3d3;
    background-color: #f9f9f9;
}

/* Unchecked состояние */
QCheckBox::indicator:unchecked {
    border: 1px solid #d3d3d3;
    background-color: #f9f9f9;
    image: none;
}

QCheckBox::indicator:unchecked:hover {
    border: 1px solid #1a8cff;
    background-color: #f0f6ff;
    image: none;
}

QCheckBox::indicator:unchecked:focus {
    border: 1px solid #005bb5;
    background-color: #f0f6ff;
    image: none;
}

/* Checked состояние - БЕЛЫЙ ФОН, стандартная граница */
QCheckBox::indicator:checked {
    border: 1px solid #0078d7;
    background-color: #ffffff; /* Белый фон */
    image: url(:/icons/check_icon.svg);
}

QCheckBox::indicator:checked:hover {
    border: 1px solid #1a8cff; /* Стандартная толщина */
    background-color: #ffffff; /* Белый фон */
    image: url(:/icons/check_icon_hover.svg);
}

QCheckBox::indicator:checked:focus {
    border: 1px solid #005bb5; /* Стандартная толщина */
    background-color: #ffffff; /* Белый фон */
    image: url(:/icons/check_icon.svg);
}

/* Disabled состояния */
QCheckBox::indicator:unchecked:disabled {
    border: 1px solid #e0e0e0;
    background-color: #f5f5f5;
    image: none;
}

QCheckBox::indicator:checked:disabled {
    border: 1px solid #cccccc;
    background-color: #f0f0f0; /* Светло-серый фон */
    image: url(:/icons/check_icon_disabled.svg);
}

QCheckBox:disabled {
    color: #999999;
}</string>
       </property>
       <property name="checked">
