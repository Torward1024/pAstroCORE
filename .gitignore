.code-workspace

# Игнорировать папку vs/, создаваемую Visual Studio
.vs/

# Игнорировать файлы с расширением .vsidx
*.vsidx

# Игнорировать другие временные файлы Visual Studio
*.suo
*.user
*.sln.docstates

# Игнорировать скомпилированные файлы
bin/
obj/
*.exe
*.dll
*.log

# Игнорировать кэш и индексы
FileContentIndex/

__pycache__/
*.py[cod]
*$py.class

# The spec that builds a download lives in `packaging/` and is kept. This is the one
# PyInstaller used to drop in the root.
/pastrocore.spec
build/
dist/

# Made by `tools/make_icons.py` from the icon the application ships, every build.
packaging/pastrocore.ico
packaging/pastrocore.icns
packaging/pastrocore.iconset/
.vscode/
pAstroCORE.code-workspace
